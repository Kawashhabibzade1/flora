# Local owner portal configuration. Copy to .env.local and use real values.
# Never commit .env.local or any production secrets.
OWNER_PASSWORD="replace-with-a-long-random-password"
OWNER_SESSION_SECRET="replace-with-at-least-32-random-characters"

# GitHub fine-grained token: restrict it to one repository with Contents: write.
GITHUB_TOKEN="github_pat_replace_me"
GITHUB_OWNER="your-github-account"
GITHUB_REPO="your-flora-repository"
GITHUB_BRANCH="main"
